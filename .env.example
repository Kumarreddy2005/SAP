# ====================================================================
# Career Orchestrator — Environment Configuration Template
# Copy this file to .env before starting the backend application
# ====================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Frontend URL for CORS configuration
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# PREREQUISITE: Requires a running PostgreSQL instance (local or hosted).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Example: postgresql://postgres:postgres@localhost:5432/career_orchestrator?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/career_orchestrator?schema=public
